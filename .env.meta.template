# ═══════════════════════════════════════════════════════════════════════════════
# Instagram / Meta — cole aqui quando o contratante enviar as credenciais
# ═══════════════════════════════════════════════════════════════════════════════
#
# Como usar:
#   1. Copie as linhas abaixo para o seu .env.local (dev) ou painel Vercel (prod)
#   2. Preencha os valores entre aspas
#   3. Reinicie o servidor (npm run dev) ou redeploy
#   4. Rode: npm run check:meta
#   5. Integrações → Instagram → Continuar com Facebook
#
# Guia detalhado: docs/META-INSTAGRAM-HANDOFF.md
# Página no CRM: /settings/integrations/guia-meta

# ── Obrigatório para login "Continuar com Facebook" ───────────────────────────
META_APP_ID=""
META_APP_SECRET=""

# URL pública do CRM (já deve existir no .env.local)
# NEXTAUTH_URL="http://localhost:3000"
# Produção: NEXTAUTH_URL="https://seu-crm.vercel.app"

# ── Webhook Instagram (produção) ──────────────────────────────────────────────
# Geralmente o MESMO valor que META_APP_SECRET (App Secret do painel Meta)
INSTAGRAM_WEBHOOK_SECRET=""

# Exige assinatura HMAC nos webhooks em produção (recomendado)
# WEBHOOK_SIGNATURE_REQUIRED="true"
