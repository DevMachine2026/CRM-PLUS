# ── Banco ─────────────────────────────────────────────────────────────────────
# Desenvolvimento local: Postgres local ou Supabase/Neon (recomendado).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Neon: use o host POOLED (com -pooler) no DATABASE_URL (runtime) e o host DIRETO
# (sem -pooler) no DIRECT_URL. O Prisma CLI (migrate/db push/studio) usa o DIRECT_URL.
# DIRECT_URL="postgresql://USER:PASS@ep-xxx.<regiao>.aws.neon.tech/neondb?sslmode=require"
# NÃO use a URL do Render (dpg-xxx) no npm run dev — exige rede estável até o host.
# Produção Render: cole a Internal Database URL inteira em uma linha no painel do serviço.

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="dev-secret-at-least-32-chars-long-here"
AUTH_SECRET="dev-secret-at-least-32-chars-long-here"
NEXTAUTH_URL="http://localhost:3000"
# Produção Render: AUTH_URL igual ao NEXTAUTH_URL (https://seu-app.onrender.com)

# ── IA (desenvolvimento — Gemini gratuito) ────────────────────────────────────
AI_PROVIDER="gemini"
GOOGLE_AI_API_KEY=""      # https://aistudio.google.com → Get API Key (gratuito)
# Modelos Gemini (opcional). Default fast/quality = gemini-2.5-flash (tem cota no free tier).
# gemini-2.0-flash e gemini-2.5-pro exigem billing habilitado (retornam 429 no free tier).
# AI_MODEL_GEMINI_FAST="gemini-2.5-flash"
# AI_MODEL_GEMINI_QUALITY="gemini-2.5-pro"   # use após habilitar billing

# ── IA (produção barata — DeepSeek, compatível com OpenAI) ────────────────────
# AI_PROVIDER="deepseek"
# DEEPSEEK_API_KEY=""     # https://platform.deepseek.com → API Keys
# AI_MODEL_DEEPSEEK_FAST="deepseek-chat"       # opcional (default)
# AI_MODEL_DEEPSEEK_QUALITY="deepseek-reasoner" # opcional, p/ tarefas complexas

# ── IA (produção — Claude) ────────────────────────────────────────────────────
# AI_PROVIDER="claude"
# ANTHROPIC_API_KEY=""    # https://console.anthropic.com

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET="gere-com-openssl-rand-hex-32"

# ── Meta (Instagram OAuth + webhooks) ─────────────────────────────────────────
# Ao receber credenciais do contratante: copie de .env.meta.template
# Guia: docs/META-INSTAGRAM-HANDOFF.md · Validação: npm run check:meta
# META_APP_ID=""
# META_APP_SECRET=""
# INSTAGRAM_WEBHOOK_SECRET=""   # em geral igual ao META_APP_SECRET (produção)
# WEBHOOK_SIGNATURE_REQUIRED="true"

# ── WhatsApp/Instagram (fallback global / modo avançado) ─────────────────────
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# Z-API webhook auth fallback (opcional, recomendado em produção):
# ZAPI_WEBHOOK_TOKEN="token-forte-do-webhook"
# Evolution GO: por padrão só conversas 1:1 no inbox (grupos desligados)
# WHATSAPP_INGEST_GROUPS="true"
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_PAGE_ID=""

# ── Evolution GO (WhatsApp via QR — Render ou local) ─────────────────────────
# Chave de segurança para desligamento operacional sem deletar código:
# ENABLE_EVOLUTION="false"   # default recomendado para operação com Z-API
# ENABLE_EVOLUTION="true"    # habilita novamente o fluxo Evolution
# URL base do servidor Evolution GO (sem barra final)
# EVOLUTION_API_URL="https://seu-evolution-go.onrender.com"
# Chave global do servidor GO (= GLOBAL_API_KEY no Render) — deve ser idêntica
# EVOLUTION_API_KEY=""
# Segredo opcional nos webhooks (?token= ou header x-evolution-webhook-token)
# EVOLUTION_WEBHOOK_SECRET=""
# Produção: exige auth nos webhooks quando EVOLUTION_API_KEY está definida
# EVOLUTION_WEBHOOK_AUTH_REQUIRED="true"
# Sem EVOLUTION_API_URL → modo demo (QR simulado + auto-conecta em ~5s)
# NEXTAUTH_URL deve apontar para o CRM (Vercel/local) — usado no webhookUrl
