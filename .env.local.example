# ── Banco ─────────────────────────────────────────────────────────────────────
# Desenvolvimento local: Postgres local ou Supabase/Neon (recomendado).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# NÃO use a URL do Render (dpg-xxx) no npm run dev — exige rede estável até o host.
# Produção Render: cole a Internal Database URL inteira em uma linha no painel do serviço.

# ── Auth ──────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="dev-secret-at-least-32-chars-long-here"
AUTH_SECRET="dev-secret-at-least-32-chars-long-here"
NEXTAUTH_URL="http://localhost:3000"
# Produção Render: AUTH_URL igual ao NEXTAUTH_URL (https://seu-app.onrender.com)

# ── IA (desenvolvimento — Gemini gratuito) ────────────────────────────────────
AI_PROVIDER="gemini"
GOOGLE_AI_API_KEY=""      # https://aistudio.google.com → Get API Key (gratuito)

# ── IA (produção — Claude) ────────────────────────────────────────────────────
# AI_PROVIDER="claude"
# ANTHROPIC_API_KEY=""    # https://console.anthropic.com

# ── Cron Jobs ─────────────────────────────────────────────────────────────────
CRON_SECRET="gere-com-openssl-rand-hex-32"

# ── WhatsApp/Instagram (Fase 6 — deixar vazio por agora) ─────────────────────
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_ACCESS_TOKEN=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# WHATSAPP_APP_SECRET=""
# Evolution GO: por padrão só conversas 1:1 no inbox (grupos desligados)
# WHATSAPP_INGEST_GROUPS="true"
# INSTAGRAM_ACCESS_TOKEN=""
# INSTAGRAM_APP_SECRET=""

# ── Evolution GO (WhatsApp via QR — Render ou local) ─────────────────────────
# URL base do servidor Evolution GO (sem barra final)
# EVOLUTION_API_URL="https://seu-evolution-go.onrender.com"
# Chave global do servidor GO (= GLOBAL_API_KEY no Render) — deve ser idêntica
# EVOLUTION_API_KEY=""
# Segredo opcional nos webhooks (?token= ou header x-evolution-webhook-token)
# EVOLUTION_WEBHOOK_SECRET=""
# Produção: exige auth nos webhooks quando EVOLUTION_API_KEY está definida
# EVOLUTION_WEBHOOK_AUTH_REQUIRED="true"
# Sem EVOLUTION_API_URL → modo demo (QR simulado + auto-conecta em ~5s)
# NEXTAUTH_URL deve apontar para o CRM (Vercel/local) — usado no webhookUrl
